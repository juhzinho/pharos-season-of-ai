# Copie este arquivo para .env e preencha UMA das chaves abaixo.
# O .env nunca vai para o git (está no .gitignore).
# NUNCA coloque chave privada de carteira aqui — nenhuma tarefa de leitura precisa disso.

# Google Gemini (tem plano gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ou OpenAI:      OPENAI_API_KEY=
# Ou Groq:        GROQ_API_KEY=
# Ou OpenRouter:  OPENROUTER_API_KEY=
# Ou Ollama local (sem chave): LLM_PROVIDER=ollama

# Opcional: trocar o modelo padrão do provedor
# LLM_MODEL=
