{
  "name": "pharos-season-of-ai",
  "version": "1.0.0",
  "description": "Builds para o Pharos Season of AI (Agent Arena) usando Chain MCP e Developer Docs MCP",
  "type": "module",
  "private": true,
  "bin": {
    "pharos-docs": "tasks/01-doc-search-cli/cli.js"
  },
  "scripts": {
    "docs": "node tasks/01-doc-search-cli/cli.js",
    "read": "node tasks/02-read-contract-state/read.js",
    "agent": "node tasks/02-read-contract-state/agent.js",
    "agent:ai": "node tasks/02-read-contract-state/agent-ai.js",
    "monitor": "node tasks/03-event-monitor/monitor.js",
    "web": "node scripts/dev-server.js",
    "test": "node --test test/intent.test.js test/docs.test.js && node test/run.js",
    "test:unit": "node --test test/intent.test.js test/docs.test.js",
    "test:e2e": "node test/run.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "viem": "^2.57.5"
  }
}
